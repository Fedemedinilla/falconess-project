{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!tests/golden/**/*.json",
      "!apps/cli/src/race/__fixtures__/logs",
      "!docs/design/prototipo"
    ]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noExplicitAny": "error" },
      "style": { "noNonNullAssertion": "error" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all" } },
  "overrides": [
    {
      "includes": ["packages/sim/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "Date": "packages/sim is pure: no Date",
                  "fetch": "packages/sim is pure"
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["docs/race-engine.md"],
      "formatter": { "enabled": false }
    }
  ]
}
