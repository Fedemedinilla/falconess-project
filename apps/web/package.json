{
  "name": "@falconess/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "vite build --mode artifact",
    "build:demo": "vite build --mode artifact && node scripts/demo.mjs",
    "preview": "vite preview",
    "test:e2e": "vite build && vite build --mode artifact && playwright test",
    "test:e2e:dev": "E2E_DEV=1 playwright test --project app",
    "test:e2e:shots": "vite build && E2E_SHOTS=1 playwright test --project shots"
  },
  "dependencies": {
    "@falconess/race-view": "workspace:*",
    "@falconess/rng": "workspace:*",
    "@falconess/schema": "workspace:*",
    "@falconess/sim": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@falconess/content": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4"
  }
}
