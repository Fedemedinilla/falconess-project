{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/bench/**/*.ts",
    "apps/*/src/**/*.test.ts",
    "apps/web/scripts/**/*.test.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ],
  "references": [
    { "path": "packages/rng" },
    { "path": "packages/schema" },
    { "path": "packages/sim" },
    { "path": "packages/content" },
    { "path": "apps/cli" },
    { "path": "apps/web/tsconfig.app.json" },
    { "path": "apps/web/tsconfig.node.json" }
  ]
}
