{
  "name": "falconess",
  "private": true,
  "version": "0.0.1",
  "description": "Raising sim with mechanical wings: deterministic off-road races, no pay-to-win.",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b tsconfig.json tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run --project sim src/race/golden.test.ts",
    "golden:update": "tsx apps/cli/src/golden-update.ts",
    "bench": "vitest bench --run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "content:validate": "tsx apps/cli/src/content-validate.ts",
    "sim": "tsx apps/cli/src/sim.ts",
    "play": "tsx apps/cli/src/play.ts",
    "sim:batch": "tsx apps/cli/src/sim-batch.ts",
    "sim:race": "tsx apps/cli/src/sim-race.ts",
    "sim:season-batch": "tsx apps/cli/src/season-batch.ts",
    "dev": "pnpm --filter @falconess/web dev",
    "web:build": "pnpm --filter @falconess/web build && pnpm --filter @falconess/web build:artifact",
    "web:e2e": "pnpm --filter @falconess/web test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
