{
  "name": "falconess",
  "private": true,
  "version": "0.0.1",
  "description": "Raising sim with mechanical wings: deterministic off-road races, no pay-to-win.",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:golden": "vitest run --project sim tests/golden",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "content:validate": "tsx apps/cli/src/content-validate.ts",
    "sim": "tsx apps/cli/src/sim.ts",
    "play": "tsx apps/cli/src/play.ts",
    "sim:batch": "tsx apps/cli/src/not-yet.ts sim:batch",
    "sim:race": "tsx apps/cli/src/not-yet.ts sim:race",
    "sim:season-batch": "tsx apps/cli/src/season-batch.ts",
    "names": "tsx apps/cli/src/names.ts",
    "names:import": "tsx apps/cli/src/names-import.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "26.6.5",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
